@model CalculatorViewModel

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        padding: 20px;
    }

    h2, h3 {
        margin-bottom: 15px;
        color: #333;
    }

    form {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        max-width: 500px;
    }

    form label {
        display: block;
        margin-top: 10px;
        font-weight: bold;
    }

    form input, form select {
        width: 100%;
        padding: 8px 10px;
        margin-top: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
    }

    form button {
        margin-top: 15px;
        padding: 10px 15px;
        background: #4a7bd0;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 15px;
    }

    form button:hover {
        background: #3a68b5;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    table th {
        background: #4a7bd0;
        color: white;
        padding: 10px;
        text-align: left;
    }

    table td {
        padding: 10px;
        border-bottom: 1px solid #eee;
    }

    table tr:nth-child(even) {
        background: #f9f9f9;
    }

    .results-box {
        background: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        max-width: 500px;
    }

    .results-box p {
        margin: 5px 0;
        font-size: 15px;
    }
</style>


<h2>Расчёт сложности боя</h2>

<form method="post">

    <label>Количество существ каждого вида (через запятую):</label>
    </br>
    <input type="text" name="KInput" value="@Model.KInput" />

    <label>Целевая сложность:</label>
    </br>
    <input type="number" step="0.1" name="Target" value="@Model.Target" />

    <label>Сценарий:</label>
    </br>
    <select name="SelectedScenary">
        @foreach (var s in Model.Scenaries)
        {
            <option value="@s" selected="@(s == Model.SelectedScenary)">
                @s
            </option>
        }
    </select>

    <button type="submit">Рассчитать</button>
    <script>
    function validateForm(event) {
        const kInput = document.querySelector("input[name='KInput']");
        const targetInput = document.querySelector("input[name='Target']");

        const kValue = kInput.value.trim();
        const targetValue = targetInput.value.trim();

        if (!kValue) {
            alert("Введите массив K (например: 10, 5, 2)");
            event.preventDefault();
            return false;
        }

        const kParts = kValue.split(",").map(x => x.trim());
        for (let part of kParts) {
            if (!/^\d+$/.test(part)) {
                alert("K должен содержать только положительные целые числа, разделённые запятыми.");
                event.preventDefault();
                return false;
            }
        }

        if (!targetValue || isNaN(targetValue)) {
            alert("Введите корректное значение сложности (число).");
            event.preventDefault();
            return false;
        }

        if (parseFloat(targetValue) <= 0) {
            alert("Сложность должна быть больше 0.");
            event.preventDefault();
            return false;
        }

        return true;
    }

    document.querySelector("form").addEventListener("submit", validateForm);
</script>

</form>

@if (Model.RawCR != null)
{
    <h3>Результаты</h3>

    <p><b>Цель:</b> @Model.Target</p>
    <p><b>Промежуточные:</b> @Model.CurrentComplexity</p>
    <p><b>Стандартизированные:</b> @Model.StandartComplexity</p>

    <table>
        <thead>
            <tr>
                <th>Количество</th>
                <th>ПО (raw)</th>
                <th>ПО (standart)</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.K.Length; i++)
        {
            <tr>
                <td>@Model.K[i]</td>
                <td>@Model.RawCR[i]</td>
                <td>@Model.StandartCR[i]</td>
            </tr>
        }
        </tbody>
    </table>
}
