@model CalculatorViewModel


<link rel="stylesheet" href="~/css/calculator.css" />
<script src="~/js/calculator.js"></script>


<h2>Расчёт сложности боя</h2>
<form method="post">

    <h2>Герои</h2>

    <label>Уровни героев (через запятую):</label>
    <input type="text" name="HeroCRInput" value="@Model.HeroCRInput" />

    <label>Количество героев каждого уровня:</label>
    <input type="text" name="HeroKInput" value="@Model.HeroKInput" />


    <h2>Противники</h2>

    <label>Количество существ каждого вида (через запятую):</label>

    <input type="text" name="KInput" value="@Model.KInput" />

    <label>Сценарий:</label>
    <select name="SelectedScenary">
        @foreach (var s in Model.Scenaries)
        {
            <option value="@s" selected="@(s == Model.SelectedScenary)">
                @Model.ScenaryLocalization[s]
            </option>
        }
    </select>



    <button type="submit">Рассчитать бой</button>

</form>


@if (Model.HeroCR != null)
{
    <h3>Сила героев: @Model.HeroComplexity</h3>

    <table>
        <thead>
            <tr>
                <th>Уровень героя</th>
                <th>Количество</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.HeroCR.Length; i++)
            {
                <tr>
                    <td>@Model.HeroCR[i]</td>
                    <td>@Model.HeroK[i]</td>
                </tr>
            }
        </tbody>
    </table>
}


@if (Model.RawCR != null)
{
    <h3>Результаты</h3>

    <p><b>Сложность героев:</b> @Model.HeroComplexity</p>
    <p><b>Промежуточные:</b> @Model.CurrentComplexity</p>
    <p><b>Стандартизированные:</b> @Model.StandartComplexity</p>

    <table>
        <thead>
            <tr>
                <th>Количество</th>
                <th>ПО (первичные)</th>
                <th>ПО (вторичные)</th>
                <th>Существа</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.K.Length; i++)
            {
                <tr>
                    <td>@Model.K[i]</td>
                    <td>@Model.RawCR[i]</td>
                    <td>@Model.StandartCR[i]</td>
                    <td>
                        <a href="/creature/@Model.Monsters[i].key">
                            @Model.Monsters[i].name
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</br>
@if (!string.IsNullOrWhiteSpace(Model.groqAnswer))
{
    <div class="results-box">
        <h3>Сгенерированная сцена</h3>
        <p style="white-space: pre-line;">
            @Model.groqAnswer
        </p>
    </div>
}




