@model dndsitgen.Models.CreatureModel

<script src="~/js/Creature/creature.js"></script>
<link rel="stylesheet" href="~/css/Creature/creature.css" />

<div class="container mt-4">

    <h1>@Model.name (@Model.type.name)</h1>
    <h5 class="text-muted">CR @Model.challenge_rating • @Model.size.name • @Model.alignment</h5>

    <hr />

    <div class="row">
        <div class="col-md-4">
            <h4>Основные параметры</h4>
            <ul>
                <li>
                    <strong>AC:</strong> @Model.armor_class
                    @if (!string.IsNullOrEmpty(Model.armor_detail))
                    {
                        <text> (@Model.armor_detail)</text>
                    }
                </li>

                <li>
                    <strong>HP:</strong>
                    @Model.hit_points
                    <a class="hp_roll" data-hp_roll=@Model.hit_dice>
                        (@Model.hit_dice)
                    </a>
                </li>

                <li><strong>EXP: </strong>@Model.experience_points</li>
                <li><strong>Инициатива:</strong> @Model.initiative_bonus</li>
                <li><strong>Пассивная внимательность:</strong> @Model.passive_perception</li>
            </ul>
        </div>

        <div class="col-md-4">
            <h4>Скорости</h4>
            <ul>
                @if (@Model.speed_all.walk != 0)
                {
                    <li><strong>Ходьба:</strong> @Model.speed_all.walk ft</li>
                }
                @if (@Model.speed_all.crawl != 0)
                {
                    <li><strong>Ползание:</strong> @Model.speed_all.crawl ft</li>
                }
                @if (@Model.speed_all.swim != 0)
                {
                    <li><strong>Плавание:</strong> @Model.speed_all.swim ft</li>
                }
                @if (@Model.speed_all.climb != 0)
                {
                    <li><strong>Лазание:</strong> @Model.speed_all.climb ft</li>
                }
                @if (@Model.speed_all.fly != 0)
                {
                    <li><strong>Полет:</strong> @Model.speed_all.fly ft</li>
                }
            </ul>
        </div>

        <div class="col-md-4">
            <h4>Зрение</h4>
            <ul>
                @if (Model.darkvision_range > 0)
                {
                    <li><strong>Тёмное зрение:</strong> @Model.darkvision_range</li>
                }

                @if (Model.blindsight_range > 0)
                {
                    <li><strong>Слепое зрение:</strong> @Model.blindsight_range</li>
                }

                @if (Model.tremorsense_range > 0)
                {
                    <li><strong>Чувство вибрации:</strong> @Model.tremorsense_range</li>
                }

                @if (Model.truesight_range > 0)
                {
                    <li><strong>Истинное зрение:</strong> @Model.truesight_range</li>
                }

            </ul>
        </div>
    </div>

    <hr />

    <h3>Характеристики</h3>

    <div class="grid-table stats-grid">
        <div class="cell header">Сила</div>
        <div class="cell header">Ловкость</div>
        <div class="cell header">Выносливость</div>
        <div class="cell header">Интеллект</div>
        <div class="cell header">Магия</div>
        <div class="cell header">Харизма</div>

        <div class="cell">@Model.ability_scores.strength</div>
        <div class="cell">@Model.ability_scores.dexterity</div>
        <div class="cell">@Model.ability_scores.constitution</div>
        <div class="cell">@Model.ability_scores.intelligence</div>
        <div class="cell">@Model.ability_scores.wisdom</div>
        <div class="cell">@Model.ability_scores.charisma</div>

        <div class="cell">@Model.modifiers.strength</div>
        <div class="cell">@Model.modifiers.dexterity</div>
        <div class="cell">@Model.modifiers.constitution</div>
        <div class="cell">@Model.modifiers.intelligence</div>
        <div class="cell">@Model.modifiers.wisdom</div>
        <div class="cell">@Model.modifiers.charisma</div>
    </div>

    <h3>Спасброски</h3>

    <div class="grid-table saves-grid">
        <div class="cell header">Сила</div>
        <div class="cell header">Ловкость</div>
        <div class="cell header">Выносливость</div>
        <div class="cell header">Интеллект</div>
        <div class="cell header">Магия</div>
        <div class="cell header">Харизма</div>

        <div class="cell">
            <a href="#" class="roll" data-bonus="@Model.saving_throws.strength">
                @Model.saving_throws.strength
            </a>
        </div>
        <div class="cell">
            <a href="#" class="roll" data-bonus="@Model.saving_throws.dexterity">
                @Model.saving_throws.dexterity
            </a>
        </div>
        <div class="cell">
            <a href="#" class="roll" data-bonus="@Model.saving_throws.constitution">
                @Model.saving_throws.constitution
            </a>
        </div>
        <div class="cell">
            <a href="#" class="roll" data-bonus="@Model.saving_throws.intelligence">
                @Model.saving_throws.intelligence
            </a>
        </div>
        <div class="cell">
            <a href="#" class="roll" data-bonus="@Model.saving_throws.wisdom">
                @Model.saving_throws.wisdom
            </a>
        </div>
        <div class="cell">
            <a href="#" class="roll" data-bonus="@Model.saving_throws.charisma">
                @Model.saving_throws.charisma
            </a>
        </div>
    </div>


    <hr />

    <h3>Навыки</h3>
    <ul>
        @foreach (var prop in Model.skill_bonuses_all.GetType().GetProperties())
        {
            var key = prop.Name;
            var value = prop.GetValue(Model.skill_bonuses_all);
            var ru = Model.skills_ru.ContainsKey(key) ? Model.skills_ru[key] : key;

            <li>
                <strong>@ru:</strong>
                <a href="#" class="roll" data-bonus="@value">
                    @value
                </a>
            </li>
        }
    </ul>


    <hr />

    <h3>Сопротивления и иммунитеты</h3>

    <div class="row">
        <div class="col-md-3">
            <h5>Иммунитеты к урону</h5>
            <ul>
                @foreach (var item in Model.resistances_and_immunities.damage_immunities)
                {
                    <li>@item.name</li>
                }
            </ul>
        </div>

        <div class="col-md-3">
            <h5>Сопротивления</h5>
            <ul>
                @foreach (var item in Model.resistances_and_immunities.damage_resistances)
                {
                    <li>@item.name</li>
                }
            </ul>
        </div>

        <div class="col-md-3">
            <h5>Уязвимости</h5>
            <ul>
                @foreach (var item in Model.resistances_and_immunities.damage_vulnerabilities)
                {
                    <li>@item.name</li>
                }
            </ul>
        </div>

        <div class="col-md-3">
            <h5>Иммунитеты к состояниям</h5>
            <ul>
                @foreach (var item in Model.resistances_and_immunities.condition_immunities)
                {
                    <li>@item.name</li>
                }
            </ul>
        </div>
    </div>

    <hr />

    <h3>Действия</h3>
    @foreach (var action in Model.actions)
    {
        <div class="mb-3">
            <h4>@action.name</h4>
            <p>@action.desc</p>

            @if (action.attacks != null && action.attacks.Any())
            {
                <ul>
                    @foreach (var atk in action.attacks)
                    {
                        <li>
                            <strong>@atk.name:</strong> +@atk.to_hit_mod к попаданию,
                            @atk.damage_die_count d @atk.damage_die_type + @atk.damage_bonus
                        </li>
                    }
                </ul>
            }
        </div>
    }

    <hr />

    <h3>Особенности</h3>
    @foreach (var trait in Model.traits)
    {
        <div class="mb-3">
            <h4>@trait.name</h4>
            <p>@trait.desc</p>
        </div>
    }

</div>
